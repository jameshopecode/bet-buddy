---
import '../styles/global.css';
import {
  SignedIn,
  SignedOut,
  UserButton,
} from '@clerk/astro/components';
import BetBuddyLogo from '../assets/bet-buddy-logo.png';
import { capitalize } from '../utils/text.utils';
import { Image } from 'astro:assets';
import BetBuddy from 'src/sections/bet-buddy/BetBuddy';
import { IoTicketOutline } from 'react-icons/io5';
import { FaQuestion } from 'react-icons/fa';
import { TbWorldQuestion } from 'react-icons/tb';
import NavLink from 'src/components/NavLink.astro';
import { cn } from 'src/utils/cn.ts';

const user = await Astro.locals.currentUser();
const userName = user?.firstName ? capitalize(user.firstName) : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Bet Buddy</title>
  </head>
  <body class="bg-dark">
    <div class="grid w-full">
      <div
        class="bg-secondary sticky top-0 right-0 left-0 z-10 flex items-center justify-center max-h-15"
      >
        <header
          class="mx-auto flex w-full max-w-[1400px] items-center justify-between rounded-md p-4"
        >
          <nav class="flex items-center gap-2">
            <NavLink to="/">
              <Image
                src={BetBuddyLogo}
                alt="Bet Buddy logo"
                width={189}
                height={26}
              />
            </NavLink>
            <NavLink to="/betting" text="Betting"><IoTicketOutline /></NavLink>
            <NavLink to="/about" text="About"><TbWorldQuestion /></NavLink>
            <NavLink to="/faq" text="FAQ"><FaQuestion /></NavLink>
          </nav>
          <aside class="flex items-center gap-4">
            <SignedOut>
              <NavLink to="/signin" text="Sign in" />
            </SignedOut>
            <SignedIn>
              <aside>Bet bright{userName ? <>, {userName}</> : '!'}</aside>
              <UserButton />
            </SignedIn>
          </aside>
        </header>
      </div>
      <div class={cn("mx-auto grid w-full max-w-[1400px]", {
        "grid-cols-[1fr_400px]": !!user,
      })}>
        <slot />
        {user && <BetBuddy userId={user?.id || ''} client:only />}
      </div>
    </div>
  </body>
</html>
