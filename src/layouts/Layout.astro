---
import '../styles/global.css';
import {
  SignedIn,
  SignedOut,
  UserButton,
  SignInButton,
} from '@clerk/astro/components';
import BetBuddyLogo from '../assets/bet-buddy-logo.png';
import { capitalize } from '../utils/text.utils';
import { Image } from 'astro:assets';

const user = await Astro.locals.currentUser();
const userName = user?.firstName ? capitalize(user.firstName) : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Bet Buddy</title>
  </head>
  <body class="bg-dark">
    <div class="grid h-screen w-full grid-rows-[60px_1fr]">
      <div class="bg-secondary flex items-center justify-center">
        <header
          class="mx-auto flex w-full max-w-[1400px] items-center justify-between rounded-md p-4"
        >
          <nav class="flex items-center gap-2">
            <div class="mt-2">
              <Image
                src={BetBuddyLogo}
                alt="Bet Buddy logo"
                width={189}
                height={26}
                class="-translate-x-4"
              />
            </div>
            <a class="p-4" href="/">Home</a>
            <a class="p-4" href="/esports">Esports</a>
            <a class="p-4" href="/sports">Sports</a>
            <a class="p-4" href="/about">About</a>
            <a class="p-4" href="/faq">FAQ</a>
          </nav>
          <aside class="flex items-center gap-4">
            <SignedOut>
              <SignInButton asChild={true}>
                <button class="cursor-pointer p-4 text-white">Sign in</button>
              </SignInButton>
            </SignedOut>
            <SignedIn>
              {userName && <p>Bet bright, {userName}</p>}
              <UserButton />
            </SignedIn>
          </aside>
        </header>
      </div>
      <div class="mx-auto w-full max-w-[1400px]">
        <slot />
      </div>
    </div>
  </body>
</html>
