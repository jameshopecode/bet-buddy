---
import Layout from 'src/layouts/Layout.astro';
import MarketsPage from 'src/sections/markets/MarketsPage.tsx';
interface Params {
  metadata: string
}

const { metadata: metadataString } = Astro.params as Params & Record<string, string | undefined>;

const { isAuthenticated } = Astro.locals.auth();

if (!isAuthenticated) {
  return Astro.redirect('/signin');
}
---

<Layout>
  <MarketsPage metadataString={metadataString} client:only />
</Layout>