---
import Layout from 'src/layouts/Layout.astro';
import MatchPage from 'src/sections/markets/MatchPage.tsx';

interface Params {
  id: string
}

const { id: idString } = Astro.params as Params & Record<string, string | undefined>;
const id = Number(idString);
---

<Layout>
    <MatchPage id={id} client:only />
</Layout>